{
    "name": "index/debugbar",
    "version": "1.0.0",
    "autoload": {
        "psr-4": {
            "Debugbar\\": "src/"
        }
    },
    "extra": {
        "index": {
            "name": "Debugbar"
        }
    },
    "require": {
        "fruitcake/laravel-debugbar": "^4.4"
    },
